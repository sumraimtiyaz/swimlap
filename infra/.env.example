# Copy to .env for `docker compose up`. These feed the db, api, and web services.

# Postgres
POSTGRES_USER=swimlap
POSTGRES_PASSWORD=swimlap
POSTGRES_DB=swimlap

# API (all prefixed SWIMLAP_)
SWIMLAP_ENVIRONMENT=dev
# CHANGE THIS in any shared/hosted environment (must be >= 8 chars).
SWIMLAP_JWT_SECRET=change-me-in-prod-please
SWIMLAP_JWT_TTL_MINUTES=1440
SWIMLAP_CORS_ALLOW_ORIGINS=["http://localhost:5173"]

# First-run coordinator seed (blank password disables seeding).
SWIMLAP_SEED_COORDINATOR_USERNAME=coordinator
SWIMLAP_SEED_COORDINATOR_PASSWORD=swimlap-admin

# Where the browser reaches the API (baked into the console bundle at build).
SWIMLAP_API_BASE_URL=http://localhost:8000
