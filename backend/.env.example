# Copy to .env and adjust. All vars are prefixed SWIMLAP_.
SWIMLAP_ENVIRONMENT=dev

# "sqlalchemy" (Postgres) or "memory" (no DB — great for local demos & the mobile team).
SWIMLAP_PERSISTENCE=sqlalchemy
SWIMLAP_DATABASE_URL=postgresql+psycopg://swimlap:swimlap@localhost:5432/swimlap

# CHANGE THIS in any shared/hosted environment (must be >= 8 chars).
SWIMLAP_JWT_SECRET=change-me-in-prod-please
SWIMLAP_JWT_TTL_MINUTES=1440

# CORS for the coordinator console dev/prod origin.
SWIMLAP_CORS_ALLOW_ORIGINS=["http://localhost:5173"]

# First-run coordinator seed (leave password blank to disable seeding in prod).
SWIMLAP_SEED_COORDINATOR_USERNAME=coordinator
SWIMLAP_SEED_COORDINATOR_PASSWORD=swimlap-admin
